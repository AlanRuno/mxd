  ],

  "negative_vectors": [
    {
      "name": "missing_mx_prefix",
      "input": "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa",
      "expected_error": "missing prefix"
    },
    {
      "name": "wrong_prefix_case",
      "input": "MX_placeholder_otherwise_valid_address",
      "expected_error": "missing prefix",
      "_note": "MXD-01 §9 requires literal lowercase 'mx'."
    },
    {
      "name": "invalid_base58",
      "input": "mx0OIl0OIl0OIl0OIl0OIl0OIl0OIl0OIl0OIl0OIl0OIl0OIl",
      "expected_error": "invalid base58 or wrong length",
      "_note": "Characters 0, O, I, l are not in the Base58 alphabet."
    },
    {
      "name": "wrong_payload_length",
      "input": "mx_placeholder_address_decoding_to_25_bytes",
      "_note": "Decodes to 25 bytes (legacy addr20 layout). MXD-01 v1.1.0 requires 37 bytes.",
      "expected_error": "invalid base58 or wrong length",
      "_placeholder": true
    },
    {
      "name": "checksum_mismatch",
      "input": "mx_placeholder_valid_payload_but_last_byte_flipped",
      "expected_error": "checksum mismatch",
      "_placeholder": true,
      "_note": "Generate by taking a valid address and flipping its last character."
    },
    {
      "name": "unknown_version_byte",
      "input": "mx_placeholder_address_with_version_0x40",
      "expected_error": "unknown version byte",
      "_placeholder": true,
      "_note": "Generate by encoding a valid 37-byte payload with version_byte = 0x40 (not in MXD-01 §5 registry). Note that 0x34 / 0x3C are NOT 'unknown' — they are reserved for the composite scheme (MXD-PQ-03) and parsers MUST recognize them as algo_id = 0x03 even though signing/verification under that algo_id is not yet active."
    },
    {
      "name": "composite_version_byte_recognized_but_unsupported",
      "input": "mx_placeholder_address_with_version_0x34",
      "expected_error": "unknown version byte",
      "_placeholder": true,
      "_note": "Version byte 0x40 (not in registry). Contrast with 0x34/0x3C which ARE in the registry and parse successfully to algo_id=0x03 — see positive vector below."
    }
  ],

  "_composite_parse_positive_note": "Per MXD-01 §9, version bytes 0x34 (mainnet composite) and 0x3C (testnet composite) parse successfully to (algo_id=0x03, addr32). The prohibition on signing and output-construction is enforced downstream, not at parse time. See test_address_parses_composite_version_byte_to_algo_id_3 in tests/test_address.c for the live test.",

  "composite_parse_positive_vectors": [
    {
      "name": "composite_mainnet_parse_succeeds_algo_id_3",
      "input": {
        "version_byte": "0x34",
        "addr32_hex": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "address_string": "mx2mNsdDJgYjxG6sc9Qs2HuDunZg6pa63nSfQ1BZEDMWgkzQWxMLd"
      },
      "_note": "Composite mainnet address with all-0xAA addr32. Parse MUST succeed and return algo_id=0x03. address_string = 'mx' + Base58Check(0x34 || addr32 || checksum4) where checksum4 = SHA-512(SHA-512(payload))[0:4] = 8d01b6ca. Filled in audit-fixup-v2 N-2 pass.",
      "expected": {
        "algo_id": "0x03",
        "addr32_hex": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "checksum4_hex": "8d01b6ca",
        "address_string": "mx2mNsdDJgYjxG6sc9Qs2HuDunZg6pa63nSfQ1BZEDMWgkzQWxMLd"
      }
    }
  ]
}
