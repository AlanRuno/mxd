{
  "spec": "MXD-01",
  "version": "1.1.2",
  "_note": "Address values marked _placeholder MUST be regenerated by the MXD-01 reference implementation before this file is promoted to the spec's Final state. The pubkey_hex inputs use well-known RFC 8032 §7.1 ed25519 keys so that any compliant implementation can reproduce the addresses. addr32 is computed as SHA-512(algo_id || pubkey)[0..31] per MXD-01 v1.1.x §4 (no longer RIPEMD-160).",

  "positive_vectors": [
    {
      "name": "rfc8032_test1_mainnet_ed25519",
      "input": {
