        "pubkey_hex": "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
        "version_byte": "0x32"
      },
      "expected": {
        "addr32_hex": "9157c53b40c9766716ed70ea577b0895c7a03d637fc2dc19d6d87a919abdb224",
        "checksum4_hex": "3e240ac0",
        "address_string": "mx2hJEQhs4UaT7rGAhYQG8XUBDQJkihNcsA7YdW4WpKt3wNZwMGq5"
      }
    },
    {
      "name": "rfc8032_test3_testnet_ed25519",
      "input": {
        "algo_id": "0x01",
        "pubkey_hex": "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
        "version_byte": "0x3A"
      },
      "expected": {
        "addr32_hex": "624c82a92e990abee154adcedb75c4a3a73662034f01b5075cad255390144301",
        "checksum4_hex": "920293e1",
        "address_string": "mx2xVU9PFqTh19HKRtXHX7Y4PwUcbpgZiZBQmqio6jSDyNApQdxTJ"
      }
    },
    {
