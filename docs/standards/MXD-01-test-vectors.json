        "pubkey_hex": "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
        "version_byte": "0x32"
      },
      "expected": {
        "addr32_hex": "44718a3e3bcc6caa950f3cf44f71e179df894739348c08d2fc574b5d857b89a5",
