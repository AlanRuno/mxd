    {
      "name": "dilithium5_active_mainnet_under_mxd_pq_01",
      "input": {
        "algo_id": "0x02",
        "pubkey_hex": "",
        "version_byte": "0x33"
      },
      "_note": "Activated by MXD-PQ-01 v1.0.0. Pubkey derived from MXD-PQ-01 abandon×11 about / account=0 vector (leaf_xi computed via HMAC-SHA-512 'ml-dsa seed' path; ML-DSA-87 KeyGen per FIPS 204 §6.1).",
      "expected": {
        "addr32_hex": "58889ff578c007f90192d1e38a41e2a12970a154876dd438545a1612c864ced0",
