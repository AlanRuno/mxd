      },
      "expected": "verify_returns_false_at_length_check"
    },
    {
      "name": "unknown_algo_id",
      "_note": "Tests MXD-03 §6 dispatch rejection.",
      "input": {
        "algo_id": "0x05",
        "pub_hex": "00",
        "msg_hex": "",
        "sig_hex": "00"
      },
      "expected": "verify_returns_false_at_dispatch"
    },
    {
      "name": "reserved_composite_algo_id",
      "_note": "Tests that algo_id = 0x03 (reserved by MXD-01 v1.1.0 for the future MXD-PQ-03 composite scheme) is rejected by MXD-03 v1.1.0 verify_mxd dispatch. Once MXD-PQ-03 is published this expectation will flip.",
      "input": {
        "algo_id": "0x03",
        "pub_hex": "00",
        "msg_hex": "",
        "sig_hex": "00"
      },
      "expected": "verify_returns_false_at_dispatch"
