  "dilithium5_vectors": [
    {
      "name": "ml_dsa_87_keypair_from_mxd_pq_01_derivation",
      "_note": "Exercises MXD-PQ-01 HD derivation followed by an ML-DSA-87 sign/verify round trip. Inputs reference the MXD-PQ-01 abandon×11 about / account=0 vector. The pq-crystals C library uses RANDOMIZED signing (DILITHIUM_RANDOMIZED_SIGNING defined in config.h), so sig4627_hex will differ between runs — it is a placeholder to be filled by running gen_test_vectors on testnet-0. The priv/pub keys are deterministic and are real values.",
