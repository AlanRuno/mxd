  "negative_vectors": [
    {
      "name": "wrong_version",
      "_failure_rule": "MXD-04 §11.1",
      "mutation": "Set tx.version = 99 (anything other than 2).",
      "expected_error": "version != 2"
    },
    {
      "name": "wrong_chain_id",
      "_failure_rule": "MXD-04 §11.2",
      "mutation": "Submit a mainnet-signed tx (chain_id = 0x4D580001) to a testnet node configured for chain_id = 0x4D580002.",
      "expected_error": "chain_id mismatch"
    },
    {
      "name": "timestamp_drift_too_large",
      "_failure_rule": "MXD-04 §11.3",
      "mutation": "Set tx.timestamp = node_clock - 120 seconds.",
      "expected_error": "timestamp drift > 60 seconds"
    },
    {
      "name": "zero_output_amount",
      "_failure_rule": "MXD-04 §11.4",
      "mutation": "Set output[0].amount = 0.",
      "expected_error": "output amount must be > 0"
    },
    {
      "name": "pubkey_addr32_mismatch",
      "_failure_rule": "MXD-04 §11.6",
      "mutation": "Replace input.public_key with a different Ed25519 pubkey (one whose addr32 does not match the consumed UTXO's owner).",
      "expected_error": "pubkey SHA-512[0..31] does not match UTXO owner addr32"
    },
    {
      "name": "mutated_signature",
      "_failure_rule": "MXD-04 §11.8",
      "mutation": "Flip a single bit in input.signature.",
      "expected_error": "signature verification failed"
    },
    {
      "name": "algo_id_mismatch_with_address",
      "_failure_rule": "MXD-04 §11.6",
      "mutation": "Submit input with algo_id = 0x02 (Dilithium5) referencing a UTXO whose owner address has version_byte 0x32 (Ed25519 mainnet).",
      "expected_error": "input algo_id does not match UTXO owner version byte"
    },
    {
      "name": "conservation_violation",
      "_failure_rule": "MXD-04 §11.7",
      "mutation": "Σ(outputs) + tip > Σ(inputs).",
      "expected_error": "input sum < output sum + tip"
    },
    {
      "name": "output_to_composite_address_before_mxd_pq_03",
      "_failure_rule": "MXD-01 §3 (wallet-construction prohibition; tested on the wallet, not on the node)",
      "_note": "Audit second-pass finding N2. Wallets MUST refuse to construct an output to an address whose parsed algo_id = 0x03 (version byte 0x34 mainnet or 0x3C testnet) until MXD-PQ-03 is published. The node-level wire format does not carry algo_id in TxOutput, so this check is enforced at the wallet's recipient-address-input layer.",
      "mutation": "User pastes a recipient address with version byte 0x34 (composite, mainnet); wallet attempts to construct a TxOutput with that addr32.",
      "expected_error": "wallet refuses output construction: algo_id = 0x03 reserved by MXD-01 §3 until MXD-PQ-03 ships"
    }
  ]
}
